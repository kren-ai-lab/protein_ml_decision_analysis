# Numerical-representations workflow for protein or peptide sequence datasets.
# Configuration is loaded from config/config.yaml and may be overridden from
# the command line using section__parameter keys.

configfile: "config/config.yaml"

from pathlib import Path
import shlex
import subprocess

import pandas as pd


# -------------------------------------------------------------------------
# Command-line configuration overrides
# -------------------------------------------------------------------------
# Nested configuration values can be overridden through the Snakemake CLI:
#
# python -m snakemake --config representation__model="provider/model_name" \
#                    representation__model_alias="model_name" \
#                    representation__batch_size=8 \
#                    analysis__enabled=true
#
# The key section__parameter=value is applied as
# config[section][parameter] = value after type conversion.

VALID_OVERRIDE_SECTIONS = {"global", "dataset", "representation", "analysis"}


def parse_override_value(value):
    """Convert a command-line configuration value to a basic Python type."""
    if value is None:
        return None

    if isinstance(value, (bool, int, float)):
        return value

    value = str(value).strip()
    low = value.lower()

    if low in {"", "none", "null", "nan", "na", "-"}:
        return None

    if low in {"true", "1", "yes", "y"}:
        return True

    if low in {"false", "0", "no", "n"}:
        return False

    try:
        return int(value)
    except ValueError:
        pass

    try:
        return float(value)
    except ValueError:
        pass

    return value


def apply_section_overrides(cfg):
    """Apply section__parameter overrides supplied through the Snakemake CLI."""
    for key, value in list(cfg.items()):
        if "__" not in key:
            continue

        section, param = key.split("__", 1)

        if section not in VALID_OVERRIDE_SECTIONS:
            print(f"[WARNING] Ignoring unknown override section: {section} from key {key}")
            continue

        if section not in cfg or cfg[section] is None:
            cfg[section] = {}

        if not isinstance(cfg[section], dict):
            raise ValueError(
                f"Cannot apply override {key} because config['{section}'] is not a dictionary."
            )

        parsed_value = parse_override_value(value)
        cfg[section][param] = parsed_value
        print(f"[CONFIG OVERRIDE] {section}.{param} = {parsed_value}")


apply_section_overrides(config)


# -------------------------------------------------------------------------
# Configuration sections
# -------------------------------------------------------------------------

GLOBAL_CFG = config.get("global", {})
DATASET_CFG = config["dataset"]
REP_CFG = config.get("representation", {})
ANALYSIS_CFG = config.get("analysis", {})

EMBEDDING_ROOT = GLOBAL_CFG["embedding_root"].rstrip("/")

DATASET_NAME = DATASET_CFG["name"]
INPUT_DATA = DATASET_CFG["input_data"]
SEQUENCE_COL = DATASET_CFG["sequence_col"]
ID_COL = DATASET_CFG["id_col"]
LABEL_COL = DATASET_CFG["label_col"]


# -------------------------------------------------------------------------
# General helpers
# -------------------------------------------------------------------------

def as_bool(value, default=False):
    """Convert Boolean-like configuration values to bool."""
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"true", "1", "yes", "y"}


def has_value(value):
    """Return whether a configuration value is non-empty and non-null."""
    if value is None:
        return False
    if isinstance(value, str) and value.strip().lower() in {"", "none", "null", "nan", "na", "-"}:
        return False
    return True


def run_command(cmd):
    """Log and execute a subprocess command, raising on failure."""
    printable = " ".join(shlex.quote(str(x)) for x in cmd)
    print(f"[CMD] {printable}")
    subprocess.run([str(x) for x in cmd], check=True)


# -------------------------------------------------------------------------
# Workflow flags
# -------------------------------------------------------------------------

REPRESENTATION_ENABLED = as_bool(REP_CFG.get("enabled", True), True)
RUN_REPRESENTATION = as_bool(
    REP_CFG.get(
        "run_representation",
        REP_CFG.get("run_embedding", False) or REP_CFG.get("run_encoding", False),
    ),
    False,
)

ANALYSIS_ENABLED = as_bool(ANALYSIS_CFG.get("enabled", False), False)


# -------------------------------------------------------------------------
# Path and representation helpers
# -------------------------------------------------------------------------

def model_alias():
    """Return a filesystem-friendly name for the representation."""
    return REP_CFG.get("model_alias", REP_CFG.get("model", "representation").split("/")[-1])


def representation_method():
    """Return the representation method."""
    return REP_CFG.get("method", "sylphy_embedding")


def representation_dir():
    """Directory where representation outputs are stored."""
    return f"{EMBEDDING_ROOT}/{DATASET_NAME}/{representation_method()}/{model_alias()}"


def output_format():
    """Return the configured representation output format."""
    return REP_CFG.get("output_format", "csv").lower()


def representation_file():
    """Main representation file expected by the workflow."""
    method = representation_method()

    if method == "sylphy_one_hot":
        return f"{representation_dir()}/encoded.csv"

    if method == "sylphy_embedding":
        return f"{representation_dir()}/embeddings.{output_format()}"

    raise ValueError(f"Unsupported representation method: {method}")


def full_data_file():
    """Dataset merged with numerical representation."""
    return f"{representation_dir()}/full_data.csv"


def analysis_dir():
    """Resolve the analysis directory using explicit and inferred paths."""
    if ANALYSIS_CFG.get("output_dir"):
        return ANALYSIS_CFG["output_dir"].rstrip("/")

    if GLOBAL_CFG.get("analysis_root"):
        root = GLOBAL_CFG["analysis_root"].rstrip("/")
        return f"{root}/{DATASET_NAME}/{representation_method()}/{model_alias()}"

    return f"{representation_dir()}/analysis"


def analysis_prefix():
    """Prefix used for analysis output files."""
    return ANALYSIS_CFG.get("prefix") or model_alias()


def analysis_kind():
    """Return the analysis required by the active representation method."""
    method = representation_method()

    if method == "sylphy_one_hot":
        return "descriptor_euclidean"

    if method == "sylphy_embedding":
        return "embedding_cosine"

    raise ValueError(f"Unsupported representation method for analysis: {method}")


def analysis_script():
    """Select the analysis script associated with the representation method."""
    # Preserve compatibility with configurations that define one explicit script.
    explicit_script = ANALYSIS_CFG.get("script")
    if has_value(explicit_script):
        return explicit_script

    scripts = ANALYSIS_CFG.get("scripts", {})
    script_key = analysis_kind()
    selected_script = scripts.get(script_key)

    if not has_value(selected_script):
        raise ValueError(
            f"No analysis script configured for '{script_key}'. Add "
            f"analysis.scripts.{script_key} to config.yaml."
        )

    return selected_script


def analysis_training_embeddings_file():
    return f"{analysis_dir()}/artifacts/training_embeddings.npy"


def analysis_percentiles_file():
    if analysis_kind() == "descriptor_euclidean":
        # Select the complementary-percentile table used by the downstream
        # one-hot descriptor-reduction workflow.
        suffix = "distance_reduction_thresholds"
    else:
        suffix = "similarity_percentiles"

    return f"{analysis_dir()}/tables/{analysis_prefix()}_{suffix}.csv"


def analysis_done_file():
    return f"{analysis_dir()}/analysis.done"


# -------------------------------------------------------------------------
# Workflow targets
# -------------------------------------------------------------------------

def final_targets():
    targets = []

    if REPRESENTATION_ENABLED:
        targets.append(full_data_file())

    if ANALYSIS_ENABLED:
        targets.append(analysis_done_file())

    if not targets:
        raise ValueError(
            "No targets selected. Set representation.enabled: true and/or analysis.enabled: true."
        )

    return targets


rule all:
    input:
        final_targets()


# -------------------------------------------------------------------------
# Representation generation and data assembly
# -------------------------------------------------------------------------

if REPRESENTATION_ENABLED and RUN_REPRESENTATION:

    rule generate_representation:
        input:
            input_data=INPUT_DATA
        output:
            rep=representation_file()
        params:
            rep_dir=representation_dir(),
            method=representation_method(),
            model=REP_CFG.get("model", ""),
            encoder=REP_CFG.get("encoder", "one_hot"),
            device=REP_CFG.get("device", "cuda"),
            precision=REP_CFG.get("precision", "fp16"),
            batch_size=REP_CFG.get("batch_size", 16),
            max_length=REP_CFG.get("max_length", None),
            sequence_col=SEQUENCE_COL,
        run:
            Path(params.rep_dir).mkdir(parents=True, exist_ok=True)
            print(f"[INFO] Generating representation in: {params.rep_dir}")

            if params.method == "sylphy_one_hot":
                cmd = [
                    "sylphy",
                    "encode-sequences",
                    "--encoder", params.encoder,
                    "--input-data", input.input_data,
                    "--sequence-identifier", params.sequence_col,
                    "--output", output.rep,
                ]

                if has_value(params.max_length):
                    cmd.extend(["--max-length", str(params.max_length)])

                run_command(cmd)

            elif params.method == "sylphy_embedding":
                cmd = [
                    "sylphy",
                    "get-embedding",
                    "--model", params.model,
                    "--input-data", input.input_data,
                    "--sequence-identifier", params.sequence_col,
                    "--output", output.rep,
                    "--device", params.device,
                    "--precision", params.precision,
                    "--batch-size", str(params.batch_size),
                ]

                if has_value(params.max_length):
                    cmd.extend(["--max-length", str(params.max_length)])

                run_command(cmd)

            else:
                raise ValueError(f"Unsupported representation method: {params.method}")


if REPRESENTATION_ENABLED:

    rule build_full_data:
        input:
            input_data=INPUT_DATA,
            rep=representation_file()
        output:
            full_data=full_data_file()
        params:
            method=representation_method(),
            output_format=output_format(),
            sequence_col=SEQUENCE_COL,
            id_col=ID_COL,
            label_col=LABEL_COL,
        run:
            input_df = pd.read_csv(input.input_data)
            required_cols = [params.sequence_col, params.id_col, params.label_col]
            missing_cols = [col for col in required_cols if col not in input_df.columns]
            if missing_cols:
                raise ValueError(
                    f"Missing required columns in input data: {missing_cols}. "
                    f"Available columns: {input_df.columns.tolist()}"
                )

            if params.output_format == "csv" or params.method == "sylphy_one_hot":
                rep_df = pd.read_csv(input.rep)
            elif params.output_format == "parquet":
                rep_df = pd.read_parquet(input.rep)
            else:
                raise ValueError(f"Unsupported output format: {params.output_format}")

            if len(input_df) != len(rep_df):
                raise ValueError(
                    f"Row mismatch between input ({len(input_df)}) and "
                    f"representation ({len(rep_df)})."
                )

            duplicated_cols = [col for col in rep_df.columns if col in input_df.columns]
            if duplicated_cols:
                rep_df = rep_df.drop(columns=duplicated_cols)

            full_df = pd.concat(
                [input_df.reset_index(drop=True), rep_df.reset_index(drop=True)],
                axis=1,
            )
            full_df = full_df.loc[:, ~full_df.columns.duplicated()]
            full_df.to_csv(output.full_data, index=False)
            print(f"[INFO] Saved full_data: {output.full_data}")


# -------------------------------------------------------------------------
# Representation-space analysis
# -------------------------------------------------------------------------

rule analyse_representation_space:
    input:
        full_data=full_data_file(),
        script=analysis_script()
    output:
        npy=analysis_training_embeddings_file(),
        percentiles=analysis_percentiles_file(),
        done=analysis_done_file()
    params:
        output_dir=analysis_dir(),
        analysis_kind=analysis_kind(),
        sequence_col=SEQUENCE_COL,
        label_col=LABEL_COL,
        id_col=ID_COL,
        feature_prefix=ANALYSIS_CFG.get("feature_prefix", "p_"),
        prefix=analysis_prefix(),
        random_state=ANALYSIS_CFG.get("random_state", 42),
        tsne_perplexity=ANALYSIS_CFG.get("tsne_perplexity", 30.0),
        tsne_max_iter=ANALYSIS_CFG.get("tsne_max_iter", 1000),
        umap_neighbors=ANALYSIS_CFG.get("umap_neighbors", 15),
        umap_min_dist=ANALYSIS_CFG.get("umap_min_dist", 0.1),
        umap_metric=ANALYSIS_CFG.get("umap_metric", "euclidean"),
        scaling_strategy=ANALYSIS_CFG.get("scaling_strategy", "none"),
        working_memory_mb=ANALYSIS_CFG.get("working_memory_mb", 512),
        n_jobs=ANALYSIS_CFG.get("n_jobs", 1),
        plot_sample_size=ANALYSIS_CFG.get("plot_sample_size", 200000),
        pairwise_csv_chunk_size=ANALYSIS_CFG.get("pairwise_csv_chunk_size", 500000),
        save_pairwise_values=as_bool(ANALYSIS_CFG.get("save_pairwise_values", True), True),
    run:
        if params.analysis_kind == "descriptor_euclidean" and params.scaling_strategy != "none":
            raise ValueError(
                "Raw one-hot Euclidean analysis requires "
                "analysis.scaling_strategy: 'none'."
            )

        Path(params.output_dir).mkdir(parents=True, exist_ok=True)

        cmd = [
            "python", input.script,
            "--emb-train", input.full_data,
            "--output-dir", params.output_dir,
            "--label-col", params.label_col,
            "--sequence-col", params.sequence_col,
            "--id-col", params.id_col,
            "--feature-prefix", params.feature_prefix,
            "--prefix", params.prefix,
            "--random-state", str(params.random_state),
            "--tsne-perplexity", str(params.tsne_perplexity),
            "--tsne-max-iter", str(params.tsne_max_iter),
            "--umap-neighbors", str(params.umap_neighbors),
            "--umap-min-dist", str(params.umap_min_dist),
            "--umap-metric", params.umap_metric,
            "--scaling-strategy", params.scaling_strategy,
        ]

        if params.analysis_kind == "descriptor_euclidean":
            cmd.extend([
                "--working-memory-mb", str(params.working_memory_mb),
                "--n-jobs", str(params.n_jobs),
                "--plot-sample-size", str(params.plot_sample_size),
                "--pairwise-csv-chunk-size", str(params.pairwise_csv_chunk_size),
            ])

            if not params.save_pairwise_values:
                cmd.append("--skip-pairwise-values")

        run_command(cmd)
        Path(output.done).touch()
