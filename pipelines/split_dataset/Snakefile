GLOBAL_CFG = config.get("global", {})
DATASET_CFG = config.get("dataset", {})
REPS_CFG = config.get("representations", {})
SOURCES_CFG = config.get("split_sources", {})
STRATEGIES_CFG = config.get("split_strategies", {})
