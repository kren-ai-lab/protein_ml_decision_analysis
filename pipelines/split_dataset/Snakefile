            threshold=wildcards.threshold,
            embeddings_path=input.emb,
            ids_path=input.ids
        )


def write_params_yaml(output_yaml, strategy_dir, seed, scenario, threshold="", embeddings_path=None, ids_path=None):
    Path(output_yaml).parent.mkdir(parents=True, exist_ok=True)

    actual_strategy = biosieve_strategy(strategy_dir)
    meta = SCENARIOS[(scenario, threshold)]
    train_rep = meta["train_rep"]

    if actual_strategy == "random_kfold":
        cfg = {
            actual_strategy: {
                "n_splits": int(STRATEGIES_CFG["random_kfold"].get("n_splits", 5)),
                "shuffle": as_bool(STRATEGIES_CFG["random_kfold"].get("shuffle", True), default=True),
                "seed": int(seed),
                "val_size": float(STRATEGIES_CFG["random_kfold"].get("val_size", 0.1)),
            }
        }

    elif actual_strategy == "stratified_kfold":
        st = STRATEGIES_CFG["stratified_kfold"]
        cfg = {
            actual_strategy: {
                "label_col": LABEL_COL,
                "n_splits": int(st.get("n_splits", 5)),
                "shuffle": as_bool(st.get("shuffle", True), default=True),
                "seed": int(seed),
                "val_size": float(st.get("val_size", 0.1)),
                "dropna": as_bool(st.get("dropna", True), default=True),
                "cast_to_str": as_bool(st.get("cast_to_str", False)),
            }
        }

    elif actual_strategy == "distance_aware_kfold":
        dt = STRATEGIES_CFG["distance_aware_kfold"]
        feature_mode = rep_feature_mode(train_rep)

        cfg = {
            actual_strategy: {
                "feature_mode": feature_mode,
                "metric": rep_metric(train_rep),
                "n_splits": int(dt.get("n_splits", 5)),
                "seed": int(seed),
                "shuffle_ties": as_bool(dt.get("shuffle_ties", True), default=True),
                "val_size": float(dt.get("val_size", 0.1)),
                "embeddings_path": str(Path(embeddings_path).resolve()),
                "ids_path": str(Path(ids_path).resolve()),
            }
        }

        if feature_mode == "descriptors":
            # Biosieve DistanceAwareKFoldSplitter expects descriptor_prefix, not feature_prefix.
            cfg[actual_strategy]["descriptor_prefix"] = rep_feature_prefix(train_rep)
            cfg[actual_strategy]["standardize_descriptors"] = as_bool(descriptor_standardize(strategy_dir))

    else:
        raise ValueError(f"Unsupported strategy: {strategy_dir}")

    with open(output_yaml, "w") as f:
        yaml.safe_dump(cfg, f, sort_keys=False)


# ============================================================
# Create splits with validation and skip report
# ============================================================


def threshold_to_parameter(threshold):
    """Convert folder names to numeric parameter values when possible."""
    if not threshold:
        return ""
    text = str(threshold)
    if text.startswith("p"):
        try:
            return float(text[1:].replace("_", "."))
        except Exception:
            return text
    if text.startswith("threshold_"):
        try:
            return float(text.replace("threshold_", ""))
        except Exception:
            return text
    if text.startswith("minseqid_"):
        raw = text.replace("minseqid_", "")
        try:
            return float(raw.replace("_", "."))
        except Exception:
            return text
    return text


def compact_counts(series):
    counts = series.value_counts(dropna=False).to_dict()
    return "{" + ", ".join(f"{k}: {v}" for k, v in counts.items()) + "}"


def clean_split_reason(reason):
    """Convert raw Biosieve logs or validation messages into a compact, readable reason."""
    if reason is None:
        return ""

    text = str(reason).strip()
    if not text:
        return ""

    # Collapse repeated whitespace introduced by multiline logs.
    text = " ".join(text.split())

    # Most Biosieve failures include an ERROR line after several INFO lines. Keep only the useful part.
    if "ERROR:" in text:
        text = text.split("ERROR:", 1)[1].strip()

    # Idempotency: if the reason was already cleaned once, do not prepend the
    # same explanatory prefix again when building split_summary.csv.
    cleaned_prefixes = (
        "Distance-aware split failed because",
        "Invalid stratified k-fold:",
        "Invalid split input:",
        "Invalid split: at least one train/val/test fold contains fewer than two classes.",
    )
    if text.startswith(cleaned_prefixes):
        return text

    # Make common errors easier to understand.
    if "Unknown parameters for DistanceAwareKFoldSplitter" in text:
        m = __import__("re").search(r"Unknown parameters for DistanceAwareKFoldSplitter: (\[[^\]]+\])", text)
        unknown = m.group(1) if m else "one or more parameters"
        return (
            "Distance-aware split failed because params_split.yaml contains unsupported parameter(s) "
            f"{unknown}. For descriptor-based splits, use 'descriptor_prefix' instead of 'feature_prefix'."
        )

    if "Some classes have fewer samples than n_splits" in text or "some classes have fewer samples than n_splits" in text:
        return "Invalid stratified k-fold: at least one class has fewer samples than n_splits. " + text

    if "has only" in text and "class(es)" in text:
        return "Invalid split: at least one train/val/test fold contains fewer than two classes. " + text

    if "input dataset has only" in text and "class(es)" in text:
        return "Invalid split input: the dataset has fewer than two classes. " + text

    if "input dataset has fewer rows than n_splits" in text:
        return "Invalid split input: the dataset has fewer rows than n_splits. " + text

    if "embeddings_path not found" in text or "ids_path not found" in text:
        return (
            "Distance-aware split failed because the temporary distance-array files were not available. "
            "This usually means split_process_inputs was cleaned or treated as temporary before Biosieve read it. "
            + text
        )

    return text


def write_split_status(status_path, scenario, strategy_dir, seed, threshold, status, reason="", full_data="", outdir=""):
    """Write one-row CSV status for a split attempt.

    status values:
      - kept: split is valid and can be used downstream.
      - invalid_split: split was skipped or generated invalid train/val/test files.
    """
    status_path = Path(str(status_path))
    status_path.parent.mkdir(parents=True, exist_ok=True)

    reason = clean_split_reason(reason)

    row = {
        "dataset_name": DATASET_NAME,
        "scenario": scenario,
        "strategy": strategy_dir,
        "biosieve_strategy": biosieve_strategy(strategy_dir),
        "seed": int(seed),
        "threshold": threshold,
        "percentile": threshold_to_parameter(threshold) if str(threshold).startswith("p") else "",
        "parameter_value": threshold_to_parameter(threshold),
        "reduction_levels": threshold if threshold else "no_threshold",
        "status": status,
        "reason": reason,
        "full_data": str(full_data),
        "outdir": str(outdir),
        "created_at": datetime.now().isoformat(timespec="seconds"),
    }
    pd.DataFrame([row]).to_csv(status_path, index=False)


def precheck_split_input(full_data_path, strategy_dir):
    """Return (is_valid, reason) before calling Biosieve.

    This prevents impossible jobs from killing the whole Snakemake run.
    """
    if not as_bool(VALIDATION_CFG.get("enabled", True), default=True):
        return True, ""

    full_data_path = Path(str(full_data_path))
    if not full_data_path.exists():
        return False, f"input file does not exist: {full_data_path}"

    df = pd.read_csv(full_data_path)
    actual_strategy = biosieve_strategy(strategy_dir)

    if df.empty:
        return False, f"input dataset has 0 rows: {full_data_path}"

    if ID_COL not in df.columns:
        return False, f"id column '{ID_COL}' not found. Columns={df.columns.tolist()}"

    # All evaluated classification splits should contain at least two classes.
    if LABEL_COL not in df.columns:
        return False, f"label column '{LABEL_COL}' not found. Columns={df.columns.tolist()}"

    label_counts = df[LABEL_COL].value_counts(dropna=False)
    min_classes = int(VALIDATION_CFG.get("min_classes", 2))
    if label_counts.shape[0] < min_classes:
        return False, f"input dataset has only {label_counts.shape[0]} class(es). Counts={label_counts.to_dict()}"

    if actual_strategy == "random_kfold":
        n_splits = int(STRATEGIES_CFG["random_kfold"].get("n_splits", 5))
    elif actual_strategy == "stratified_kfold":
        n_splits = int(STRATEGIES_CFG["stratified_kfold"].get("n_splits", 5))
    elif actual_strategy == "distance_aware_kfold":
        n_splits = int(STRATEGIES_CFG["distance_aware_kfold"].get("n_splits", 5))
    else:
        n_splits = 5

    if df.shape[0] < n_splits:
        return False, f"input dataset has fewer rows than n_splits. n_rows={df.shape[0]}, n_splits={n_splits}"

    # StratifiedKFold requires every class to have at least n_splits samples.
    if actual_strategy == "stratified_kfold":
        bad = {k: int(v) for k, v in label_counts.items() if int(v) < n_splits}
        if bad:
            return False, f"some classes have fewer samples than n_splits={n_splits}. Problem classes={bad}. Counts={label_counts.to_dict()}"

    return True, ""


def validate_split_outputs(outdir):
    """Return (is_valid, reason) after Biosieve creates split files."""
    if not as_bool(VALIDATION_CFG.get("enabled", True), default=True):
        return True, ""

    outdir = Path(str(outdir))
    if not outdir.exists():
        return False, f"output directory was not created: {outdir}"

    fold_dirs = sorted([p for p in outdir.glob("fold_*") if p.is_dir()])
    if not fold_dirs:
        return False, f"no fold_* directories were created in {outdir}"

    required_files = VALIDATION_CFG.get("required_split_files", ["train.csv", "val.csv", "test.csv"])
    min_classes = int(VALIDATION_CFG.get("min_classes_per_split", 2))
    issues = []

    for fold_dir in fold_dirs:
        for filename in required_files:
            path = fold_dir / filename
            split_name = Path(filename).stem
            if not path.exists():
                issues.append(f"{path.relative_to(outdir)}: missing split file")
                continue

            try:
                df = pd.read_csv(path)
            except Exception as exc:
                issues.append(f"{path.relative_to(outdir)}: could not read csv: {exc}")
                continue

            if df.empty:
                issues.append(f"{path.relative_to(outdir)}: split '{split_name}' has 0 rows")
                continue

            if LABEL_COL not in df.columns:
                issues.append(f"{path.relative_to(outdir)}: label column '{LABEL_COL}' not found")
                continue

            n_classes = df[LABEL_COL].nunique(dropna=False)
            if n_classes < min_classes:
                issues.append(
                    f"{path.relative_to(outdir)}: split '{split_name}' has only {n_classes} class(es). Counts={compact_counts(df[LABEL_COL])}"
                )

    if issues:
        return False, " | ".join(issues)

    return True, ""


def remove_split_artifacts(outdir, remove_logs=False):
    """Remove generated split files without deleting params_split.yaml or summaries.

    This is used to avoid stale fold_* directories from previous runs and to prevent
    invalid splits from looking valid just because Biosieve wrote train/val/test files
    before post-validation failed.
    """
    outdir = Path(str(outdir))
    if not outdir.exists():
        return

    for fold_dir in outdir.glob("fold_*"):
        if fold_dir.is_dir():
            shutil.rmtree(fold_dir)

    for filename in ["kfold_report.json", "INVALID_SPLIT.txt", "DONE.txt"]:
        path = outdir / filename
        if path.exists():
            path.unlink()

    if remove_logs:
        for filename in ["biosieve_split.stdout.log", "biosieve_split.stderr.log"]:
            path = outdir / filename
            if path.exists():
                path.unlink()


def clean_outdir_before_split(outdir):
    if as_bool(VALIDATION_CFG.get("remove_stale_outputs_before_split", True), default=True):
        remove_split_artifacts(outdir, remove_logs=True)


def handle_invalid_generated_split(outdir, threshold=""):
    """Remove invalid split outputs so they cannot be used by mistake.

    For thresholded reductions (percentiles or homology thresholds), an invalid
    run should not leave a pXX/ or threshold_XX folder at all. The reason remains
    traceable in the seed-level split_summary.csv through the hidden status row.

    For no-threshold runs, the output directory is the seed directory itself, so
    we only remove fold artifacts and keep the seed folder for split_summary.csv.
    """
    keep_invalid = as_bool(VALIDATION_CFG.get("keep_invalid_fold_files", False), default=False)
    remove_invalid_dir = as_bool(VALIDATION_CFG.get("remove_invalid_run_dirs", True), default=True)

    outdir = Path(str(outdir))

    if keep_invalid:
        return

    if threshold and remove_invalid_dir:
        if outdir.exists():
            shutil.rmtree(outdir)
        return

    remove_split_artifacts(outdir, remove_logs=False)


def run_biosieve_split_safely(full_data, params_yaml, outdir, strategy_dir, seed, scenario, threshold, status_path, done_path=None):
    """Run Biosieve split and always write a status row.

    Important behavior:
    - If the split is valid, the run directory is kept and DONE.txt is written.
    - If the split is invalid and it corresponds to a percentile/threshold,
      the whole pXX/ or threshold_XX/ directory is removed, so downstream code
      cannot accidentally use invalid train/val/test files.
    - The invalid reason is still saved in the hidden status row and then in the
      public seed-level split_summary.csv.
    """
    outdir = Path(str(outdir))
    outdir.mkdir(parents=True, exist_ok=True)
    clean_outdir_before_split(outdir)

    done_path = Path(str(done_path)) if done_path not in [None, "", "null"] else None
    status_path = Path(str(status_path))

    ok, reason = precheck_split_input(full_data, strategy_dir)
    if not ok:
        write_split_status(
            status_path=status_path,
            scenario=scenario,
            strategy_dir=strategy_dir,
            seed=seed,
            threshold=threshold,
            status="invalid_split",
            reason=reason,
            full_data=full_data,
            outdir=outdir,
        )
        handle_invalid_generated_split(outdir, threshold=threshold)
        if not threshold:
            (outdir / "INVALID_SPLIT.txt").write_text(clean_split_reason(reason) + "\n", encoding="utf-8")
            if done_path is not None:
                done_path.write_text("invalid_split\n", encoding="utf-8")
        print(f"[WARNING] Skipping invalid split: {scenario} {strategy_dir} seed={seed} threshold={threshold}. {reason}")
        return

    actual_strategy = biosieve_strategy(strategy_dir)
    cmd = [
        BIOSIEVE_EXEC,
        "split",
        "-i", str(full_data),
        "-o", str(outdir),
        "--strategy", str(actual_strategy),
        "--id-column", str(ID_COL),
        "--params", str(params_yaml),
    ]

    print("[CMD] " + " ".join(cmd))
    result = subprocess.run(cmd, text=True, capture_output=True)

    (outdir / "biosieve_split.stdout.log").write_text(result.stdout or "", encoding="utf-8")
    (outdir / "biosieve_split.stderr.log").write_text(result.stderr or "", encoding="utf-8")

    if result.returncode != 0:
        reason = (result.stderr or result.stdout or f"biosieve split failed with return code {result.returncode}").strip()
        reason = " ".join(reason.split())
        write_split_status(
            status_path=status_path,
            scenario=scenario,
            strategy_dir=strategy_dir,
            seed=seed,
            threshold=threshold,
            status="invalid_split",
            reason=reason,
            full_data=full_data,
            outdir=outdir,
        )
        handle_invalid_generated_split(outdir, threshold=threshold)
        if not threshold:
            (outdir / "INVALID_SPLIT.txt").write_text(clean_split_reason(reason) + "\n", encoding="utf-8")
            if done_path is not None:
                done_path.write_text("invalid_split\n", encoding="utf-8")
        print(f"[WARNING] Biosieve failed but workflow continues. See {status_path}")
        return

    valid, reason = validate_split_outputs(outdir)
    if valid:
        write_split_status(
            status_path=status_path,
            scenario=scenario,
            strategy_dir=strategy_dir,
            seed=seed,
            threshold=threshold,
            status="kept",
            reason="",
            full_data=full_data,
            outdir=outdir,
        )
        if done_path is not None:
            done_path.write_text("kept\n", encoding="utf-8")
    else:
        write_split_status(
            status_path=status_path,
            scenario=scenario,
            strategy_dir=strategy_dir,
            seed=seed,
            threshold=threshold,
            status="invalid_split",
            reason=reason,
            full_data=full_data,
            outdir=outdir,
        )
        handle_invalid_generated_split(outdir, threshold=threshold)
        if not threshold:
            (outdir / "INVALID_SPLIT.txt").write_text(clean_split_reason(reason) + "\n", encoding="utf-8")
            if done_path is not None:
                done_path.write_text("invalid_split\n", encoding="utf-8")
        print(f"[WARNING] Split created but marked invalid. Invalid run folder was removed when thresholded. See {status_path}")


rule create_basic_splits_no_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "full_data.csv"),
        params_yaml=str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / "params_split.yaml")
    output:
        status_row=temp(str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / ".split_status_rows" / "no_threshold.csv"))
    wildcard_constraints:
        strategy="random_kfold|stratified_kfold"
    params:
        outdir=lambda wc: split_output_dir(wc.scenario, wc.strategy, wc.seed, ""),
        done=lambda wc: split_done_path(wc.scenario, wc.strategy, wc.seed, "")
    run:
        run_biosieve_split_safely(
            full_data=input.full_data,
            params_yaml=input.params_yaml,
            outdir=params.outdir,
            strategy_dir=wildcards.strategy,
            seed=wildcards.seed,
            scenario=wildcards.scenario,
            threshold="",
            status_path=output.status_row,
            done_path=params.done,
        )


rule create_basic_splits_with_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "full_data.csv"),
        params_yaml=str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / "{threshold}" / "params_split.yaml")
    output:
        status_row=temp(str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / ".split_status_rows" / "{threshold}.csv"))
    wildcard_constraints:
        strategy="random_kfold|stratified_kfold"
    params:
        outdir=lambda wc: split_output_dir(wc.scenario, wc.strategy, wc.seed, wc.threshold),
        done=lambda wc: split_done_path(wc.scenario, wc.strategy, wc.seed, wc.threshold)
    run:
        run_biosieve_split_safely(
            full_data=input.full_data,
            params_yaml=input.params_yaml,
            outdir=params.outdir,
            strategy_dir=wildcards.strategy,
            seed=wildcards.seed,
            scenario=wildcards.scenario,
            threshold=wildcards.threshold,
            status_path=output.status_row,
            done_path=params.done,
        )


rule create_distance_splits_no_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "full_data.csv"),
        params_yaml=str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / "params_split.yaml"),
        emb=str(MATERIALIZED_ROOT / "{scenario}" / "_distance_arrays" / "embeddings.npy"),
        ids=str(MATERIALIZED_ROOT / "{scenario}" / "_distance_arrays" / "embedding_ids.csv")
    output:
        status_row=temp(str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / ".split_status_rows" / "no_threshold.csv"))
    wildcard_constraints:
        strategy="distance_aware_kfold|distance_aware_kfold_no_norm|distance_aware_kfold_norm"
    params:
        outdir=lambda wc: split_output_dir(wc.scenario, wc.strategy, wc.seed, ""),
        done=lambda wc: split_done_path(wc.scenario, wc.strategy, wc.seed, "")
    run:
        # emb and ids are explicit inputs so Snakemake cannot delete or ignore them
        # before Biosieve reads the paths stored inside params_split.yaml.
        run_biosieve_split_safely(
            full_data=input.full_data,
            params_yaml=input.params_yaml,
            outdir=params.outdir,
            strategy_dir=wildcards.strategy,
            seed=wildcards.seed,
            scenario=wildcards.scenario,
            threshold="",
            status_path=output.status_row,
            done_path=params.done,
        )


rule create_distance_splits_with_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "full_data.csv"),
        params_yaml=str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / "{threshold}" / "params_split.yaml"),
        emb=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "_distance_arrays" / "embeddings.npy"),
        ids=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "_distance_arrays" / "embedding_ids.csv")
    output:
        status_row=temp(str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / ".split_status_rows" / "{threshold}.csv"))
    wildcard_constraints:
        strategy="distance_aware_kfold|distance_aware_kfold_no_norm|distance_aware_kfold_norm"
    params:
        outdir=lambda wc: split_output_dir(wc.scenario, wc.strategy, wc.seed, wc.threshold),
        done=lambda wc: split_done_path(wc.scenario, wc.strategy, wc.seed, wc.threshold)
    run:
        # emb and ids are explicit inputs so Snakemake cannot delete or ignore them
        # before Biosieve reads the paths stored inside params_split.yaml.
        run_biosieve_split_safely(
            full_data=input.full_data,
            params_yaml=input.params_yaml,
            outdir=params.outdir,
            strategy_dir=wildcards.strategy,
            seed=wildcards.seed,
            scenario=wildcards.scenario,
            threshold=wildcards.threshold,
            status_path=output.status_row,
            done_path=params.done,
        )

def split_summary_inputs(wc):
    key = (wc.scenario, wc.strategy, int(wc.seed))
    if key not in SEED_STATUS_ROWS:
        raise KeyError(f"No status rows registered for seed-level split summary: {key}")
    return SEED_STATUS_ROWS[key]


def write_seed_summary_table(row_files, output_csv):
    frames = []
    for path in row_files:
        df = pd.read_csv(path)
        frames.append(df)

    if not frames:
        raise ValueError(f"No split status rows found for {output_csv}")

    df = pd.concat(frames, ignore_index=True)

    # Sort in the natural order used by reduction folders.
    if "parameter_value" in df.columns:
        df["_sort_value"] = pd.to_numeric(df["parameter_value"], errors="coerce")
    else:
        df["_sort_value"] = pd.NA
    df["_sort_value"] = df["_sort_value"].fillna(-1)
    df = df.sort_values(["_sort_value", "reduction_levels"]).drop(columns=["_sort_value"])

    reduction_levels = df.get("reduction_levels", pd.Series(dtype=str)).astype(str).tolist()

    # Keep public reasons concise even if an upstream tool produced verbose logs.
    if "reason" in df.columns:
        df["reason"] = df["reason"].fillna("").map(clean_split_reason)

    if reduction_levels and all(x == "no_threshold" for x in reduction_levels):
        out = df[["reduction_levels", "status", "reason"]].copy()
    elif reduction_levels and all(x.startswith("p") for x in reduction_levels):
        out = df[["percentile", "reduction_levels", "status", "reason"]].copy()
    elif reduction_levels and all(x.startswith("threshold_") or x.startswith("minseqid_") for x in reduction_levels):
        out = df[["parameter_value", "reduction_levels", "status", "reason"]].copy()
        out = out.rename(columns={"parameter_value": "min_seq_id"})
    else:
        out = df[["parameter_value", "reduction_levels", "status", "reason"]].copy()

    output_csv = Path(str(output_csv))
    output_csv.parent.mkdir(parents=True, exist_ok=True)
    out.to_csv(output_csv, index=False)


rule write_seed_split_summary:
    input:
        rows=split_summary_inputs
    output:
        summary=str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / "split_summary.csv")
    run:
        write_seed_summary_table(input.rows, output.summary)
