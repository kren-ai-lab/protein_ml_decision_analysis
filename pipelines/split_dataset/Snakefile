    SPLIT_ROOT = SPLIT_ROOT_BASE / DATASET_NAME
else:
    SPLIT_ROOT = SPLIT_ROOT_BASE


def split_summary_root():
    """Return the dataset-level summary directory for split-process analysis."""
    configured = ANALYSIS_CFG.get("output_dir")
    if configured not in [None, "", "null"]:
        return Path(str(configured)).resolve()
    summary_dirname = ANALYSIS_CFG.get("summary_dirname", "split_analysis")
    return SPLIT_ROOT / summary_dirname


MATERIALIZED_ROOT = Path(OUTPUT_CFG.get(
    "materialized_root",
    OUTPUT_ROOT / "split_process_inputs" / DATASET_NAME
))

BIOSIEVE_EXEC = STRATEGIES_CFG.get("biosieve_exec", "biosieve")
TRAIN_REPS = CROSS_CFG.get("train_representations", list(REPS_CFG.keys()))

# ============================================================
# Wildcard constraints
# ============================================================
# Snakemake wildcards match '/' by default. Without this block, a path like:
#   <scenario>/p30_0/full_data.csv
# can be interpreted as scenario='<scenario>/p30_0' instead of
# scenario='<scenario>' and threshold='p30_0'. This causes KeyError and
# AmbiguousRuleException between no-threshold and with-threshold rules.
wildcard_constraints:
    scenario = r"[^/]+",
    threshold = r"(?:p[0-9]+(?:_[0-9]+)?|threshold_[0-9]+(?:\.[0-9]+)?)",
    strategy = r"(?:random_kfold|stratified_kfold|distance_aware_kfold|distance_aware_kfold_no_norm|distance_aware_kfold_norm)",
    seed = r"[0-9]+"



# ============================================================
# Helpers
# ============================================================

def enabled(x):
    return as_bool(x.get("enabled", False))


def rep_cfg(rep_key):
    if rep_key not in REPS_CFG:
        raise ValueError(f"Unknown representation key: {rep_key}")
    return REPS_CFG[rep_key]


def rep_output_name(rep_key):
    rep = rep_cfg(rep_key)
    return rep.get("output_name", rep.get("model_alias", rep_key))


def rep_full_data(rep_key):
    rep = rep_cfg(rep_key)
    return str(REP_ROOT / DATASET_NAME / rep["method"] / rep["model_alias"] / "full_data.csv")


def rep_feature_mode(rep_key):
    return rep_cfg(rep_key).get("feature_mode", "embeddings")


def rep_metric(rep_key):
    default = "euclidean" if rep_feature_mode(rep_key) == "descriptors" else "cosine"
    return rep_cfg(rep_key).get("metric", default)


def rep_feature_prefix(rep_key):
    return rep_cfg(rep_key).get("feature_prefix", "p_")


def path_from_config(value):
    """Resolve paths. Absolute paths are kept; relative paths are resolved from the Snakefile working directory."""
    p = Path(str(value))
    return p if p.is_absolute() else p.resolve()


def list_threshold_dirs(root, threshold_spec):
    root = Path(root)

    if threshold_spec == "auto":
        if not root.exists():
            raise ValueError(f"Reduction root does not exist: {root}")
        out = []
        for d in root.iterdir():
            if not d.is_dir():
                continue
            if d.name.startswith(("p", "threshold_", "minseqid_")):
                out.append(d.name)
        return sorted(out)

    if threshold_spec is None:
        return []

    return [str(x) for x in threshold_spec]


def reduced_file_for(root, threshold, kind):
    d = Path(root) / threshold

    candidates = []
    if kind in ["reduced_distance", "reduced_descriptor"]:
        candidates = [
            d / "data_nr_labeled.csv",
            d / "data_nr.csv",
        ]
    elif kind == "reduced_homology":
        candidates = [
            d / "data_nr_labeled.csv",
            d / "data_nr_mmseqs2.csv",
            d / "data_nr.csv",
        ]

    for c in candidates:
        if c.exists():
            return str(c)

    # Return the first expected path so Snakemake reports a useful MissingInputException.
    return str(candidates[0])


def source_label(source_kind):
    if source_kind == "no_reduced":
        return "no_reduced"
    if source_kind == "reduced_distance":
        return "reduced_distance"
    if source_kind == "reduced_homology":
        return "reduced_homology"
    if source_kind == "reduced_descriptor":
        return "reduced_descriptor"
    return source_kind


def scenario_name(train_rep, source_kind, reduction_rep_key=None):
    train_name = rep_output_name(train_rep)

    if source_kind == "no_reduced":
        return f"{train_name}_no_reduced"

    if source_kind == "reduced_distance":
        red_name = rep_output_name(reduction_rep_key)
        if train_name == red_name:
            return f"{train_name}_reduced_distance"
        return f"{train_name}_reduced_distance_by_{red_name}"

    if source_kind == "reduced_descriptor":
        red_name = rep_output_name(reduction_rep_key)
        if train_name == red_name:
            return f"{train_name}_reduced_descriptor"
        return f"{train_name}_reduced_descriptor_by_{red_name}"

    if source_kind == "reduced_homology":
        return f"{train_name}_reduced_homology"

    raise ValueError(f"Unknown source kind: {source_kind}")


def materialized_full_data_path(scenario, threshold=""):
    if threshold:
        return str(MATERIALIZED_ROOT / scenario / threshold / "full_data.csv")
    return str(MATERIALIZED_ROOT / scenario / "full_data.csv")


def split_done_path(scenario, strategy_dir, seed, threshold=""):
    if threshold:
        return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / threshold / "DONE.txt")
    return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / "DONE.txt")


def split_params_path(scenario, strategy_dir, seed, threshold=""):
    if threshold:
        return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / threshold / "params_split.yaml")
    return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / "params_split.yaml")


def split_status_row_path(scenario, strategy_dir, seed, threshold=""):
    """Hidden one-row status file used internally to build seed-level split_summary.csv."""
    reduction_levels = threshold if threshold else "no_threshold"
    return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / ".split_status_rows" / f"{reduction_levels}.csv")


def seed_split_summary_path(scenario, strategy_dir, seed):
    """Public seed-level summary expected by downstream analysis."""
    return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / "split_summary.csv")


def split_output_dir(scenario, strategy_dir, seed, threshold=""):
    if threshold:
        return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}" / threshold)
    return str(SPLIT_ROOT / scenario / strategy_dir / f"seed_{seed}")


def arrays_dir_for(scenario, threshold=""):
    if threshold:
        return str(MATERIALIZED_ROOT / scenario / threshold / "_distance_arrays")
    return str(MATERIALIZED_ROOT / scenario / "_distance_arrays")


def arrays_emb_path(scenario, threshold=""):
    return str(Path(arrays_dir_for(scenario, threshold)) / "embeddings.npy")


def arrays_ids_path(scenario, threshold=""):
    return str(Path(arrays_dir_for(scenario, threshold)) / "embedding_ids.csv")


def strategy_is_distance(strategy_dir):
    return strategy_dir.startswith("distance_aware_kfold")


def biosieve_strategy(strategy_dir):
    if strategy_is_distance(strategy_dir):
        return "distance_aware_kfold"
    return strategy_dir


def descriptor_standardize(strategy_dir):
    return strategy_dir.endswith("_norm")


def active_strategy_dirs_for_rep(train_rep):
    strategy_dirs = []

    random_cfg = STRATEGIES_CFG.get("random_kfold", {})
    if enabled(random_cfg):
        strategy_dirs.append(random_cfg.get("output_name", "random_kfold"))

    strat_cfg = STRATEGIES_CFG.get("stratified_kfold", {})
    if enabled(strat_cfg):
        strategy_dirs.append(strat_cfg.get("output_name", "stratified_kfold"))

    dist_cfg = STRATEGIES_CFG.get("distance_aware_kfold", {})
    if enabled(dist_cfg):
        if rep_feature_mode(train_rep) == "descriptors":
            modes = dist_cfg.get("descriptor_modes", ["no_norm"])
            for mode in modes:
                if mode == "norm":
                    strategy_dirs.append("distance_aware_kfold_norm")
                elif mode == "no_norm":
                    strategy_dirs.append("distance_aware_kfold_no_norm")
                else:
                    raise ValueError(f"Unknown descriptor distance-aware mode: {mode}")
        else:
            strategy_dirs.append(dist_cfg.get("output_name", "distance_aware_kfold"))

    return strategy_dirs


# ============================================================
# Build scenario table
# ============================================================

SCENARIOS = {}
SEED_STATUS_ROWS = {}
SEED_SUMMARY_TARGETS = set()
TARGETS = []


def add_split_attempt_target(scenario, strategy_dir, seed, threshold=""):
    """Register one split attempt and its seed-level summary target."""
    seed = int(seed)
    row_path = split_status_row_path(scenario, strategy_dir, seed, threshold)
    key = (scenario, strategy_dir, seed)
    SEED_STATUS_ROWS.setdefault(key, []).append(row_path)
    SEED_SUMMARY_TARGETS.add(seed_split_summary_path(scenario, strategy_dir, seed))


def add_scenario(
    train_rep,
    source_kind,
    source_file,
    threshold="",
    reduction_rep_key=None,
):
    scenario = scenario_name(train_rep, source_kind, reduction_rep_key)

    key = (scenario, threshold)
    if key not in SCENARIOS:
        SCENARIOS[key] = {
            "scenario": scenario,
            "threshold": threshold,
            "train_rep": train_rep,
            "source_kind": source_kind,
            "source_file": source_file,
            "reduction_rep_key": reduction_rep_key or "",
            "materialized": materialized_full_data_path(scenario, threshold),
        }

    for strategy_dir in active_strategy_dirs_for_rep(train_rep):
        for seed in SEEDS:
            add_split_attempt_target(scenario, strategy_dir, seed, threshold)


# ----- no reduction -----
if enabled(SOURCES_CFG.get("no_reduced", {})):
    for train_rep in TRAIN_REPS:
        add_scenario(
            train_rep=train_rep,
            source_kind="no_reduced",
            source_file=rep_full_data(train_rep),
            threshold="",
            reduction_rep_key=None,
        )


# ----- distance-reduced datasets -----
rd_cfg = SOURCES_CFG.get("reduced_distance", {})
if enabled(rd_cfg):
    for red_key, red_cfg in rd_cfg.get("reductions", {}).items():
        if not enabled(red_cfg):
            continue

        root = red_cfg.get(
            "root",
            REDUCTION_ROOT / "reduced_distance" / DATASET_NAME / f"{red_key}_embedding_distance_reduction"
        )
        root = path_from_config(root)
        thresholds = list_threshold_dirs(root, red_cfg.get("thresholds", "auto"))

        reduction_rep_key = red_cfg.get("representation_key", red_key)

        for threshold in thresholds:
            src = reduced_file_for(root, threshold, "reduced_distance")
            for train_rep in TRAIN_REPS:
                add_scenario(
                    train_rep=train_rep,
                    source_kind="reduced_distance",
                    source_file=src,
                    threshold=threshold,
                    reduction_rep_key=reduction_rep_key,
                )


# ----- descriptor-reduced datasets -----
rdesc_cfg = SOURCES_CFG.get("reduced_descriptor", {})
if enabled(rdesc_cfg):
    for red_key, red_cfg in rdesc_cfg.get("reductions", {}).items():
        if not enabled(red_cfg):
            continue

        root = red_cfg.get(
            "root",
            REDUCTION_ROOT / "reduced_descriptor" / DATASET_NAME / f"{red_key}_reduction"
        )
        root = path_from_config(root)
        thresholds = list_threshold_dirs(root, red_cfg.get("thresholds", "auto"))
        reduction_rep_key = red_cfg.get("representation_key", red_key)

        for threshold in thresholds:
            src = reduced_file_for(root, threshold, "reduced_descriptor")
            for train_rep in TRAIN_REPS:
                add_scenario(
                    train_rep=train_rep,
                    source_kind="reduced_descriptor",
                    source_file=src,
                    threshold=threshold,
                    reduction_rep_key=reduction_rep_key,
                )


# ----- homology-reduced datasets -----
rh_cfg = SOURCES_CFG.get("reduced_homology", {})
if enabled(rh_cfg):
    for red_key, red_cfg in rh_cfg.get("reductions", {}).items():
        if not enabled(red_cfg):
            continue

        root = red_cfg.get(
            "root",
            REDUCTION_ROOT / "reduced_homology" / DATASET_NAME / red_key
        )
        root = path_from_config(root)
        thresholds = list_threshold_dirs(root, red_cfg.get("thresholds", "auto"))

        for threshold in thresholds:
            src = reduced_file_for(root, threshold, "reduced_homology")
            for train_rep in TRAIN_REPS:
                add_scenario(
                    train_rep=train_rep,
                    source_kind="reduced_homology",
                    source_file=src,
                    threshold=threshold,
                    reduction_rep_key=red_key,
                )


if not SEED_SUMMARY_TARGETS:
    raise ValueError("No split targets were generated. Check enabled flags in config.yaml.")

# Public split targets are seed-level split_summary.csv files. Each summary depends on
# hidden per-run status rows created by the split rules.
SPLIT_TARGETS = sorted(SEED_SUMMARY_TARGETS)
TARGETS = list(SPLIT_TARGETS)
ANALYSIS_DONE_TARGET = str(split_summary_root() / "analysis.done")

if ANALYSIS_ENABLED:
    TARGETS.append(ANALYSIS_DONE_TARGET)

def cleanup_marker_path():
    cleanup_dir = split_summary_root() if ANALYSIS_ENABLED else SPLIT_ROOT
    return str(Path(cleanup_dir) / ".materialized_inputs_removed.done")

if CLEANUP_MATERIALIZED:
    TARGETS.append(cleanup_marker_path())


