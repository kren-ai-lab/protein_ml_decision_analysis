VALIDATION_CFG = config.get("validation", {})
ANALYSIS_CFG = config.get("analysis", {})
ANALYSIS_ENABLED = as_bool(ANALYSIS_CFG.get("enabled", False))
CLEANUP_CFG = config.get("cleanup", {})
CLEANUP_MATERIALIZED = as_bool(CLEANUP_CFG.get("remove_materialized_inputs", False))

OUTPUT_ROOT = Path(GLOBAL_CFG.get("output_root", ".")).resolve()
REP_ROOT = Path(GLOBAL_CFG.get("representation_root", "../../numerical_representation_data")).resolve()
REDUCTION_ROOT = Path(GLOBAL_CFG.get("reduction_root", "../..")).resolve()

DATASET_NAME = DATASET_CFG["name"]
INPUT_DATA = Path(DATASET_CFG["input_data"]).resolve()
SEQUENCE_COL = DATASET_CFG.get("sequence_col", "sequence")
ID_COL = DATASET_CFG.get("id_col", "id")
LABEL_COL = DATASET_CFG.get("label_col", "label")

