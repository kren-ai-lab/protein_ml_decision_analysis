configfile: "config/config.yaml"

from pathlib import Path
import shutil
import json
import subprocess
from datetime import datetime
import pandas as pd
import yaml




def as_bool(value, default=False):
    """Parse booleans robustly from YAML/CLI values.

    This avoids Python's bool("false") == True behavior, which can
    accidentally activate cleanup or other optional stages.
    """
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)):
        return bool(value)
    return str(value).strip().lower() in {"true", "1", "yes", "y", "on"}

