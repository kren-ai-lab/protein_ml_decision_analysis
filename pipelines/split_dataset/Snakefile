        TARGETS


rule analyse_split_process:
    input:
        SPLIT_TARGETS
    output:
        done=str(split_summary_root() / "analysis.done")
    params:
        script=lambda wc: str(Path(ANALYSIS_CFG.get("script", "../../notebooks_and_scripts/scripts_for_pipelines/split_summary.py")).resolve()),
        split_root=lambda wc: str(SPLIT_ROOT.resolve()),
        output_dir=lambda wc: str(split_summary_root().resolve()),
        fig_format=lambda wc: ANALYSIS_CFG.get("plots", {}).get("fig_format", "png"),
        dpi=lambda wc: int(ANALYSIS_CFG.get("plots", {}).get("dpi", 300)),
        cmap=lambda wc: ANALYSIS_CFG.get("plots", {}).get("cmap", "YlGnBu"),
        annotate=lambda wc: str(ANALYSIS_CFG.get("plots", {}).get("annotate", True)).lower(),
        include_no_threshold=lambda wc: str(ANALYSIS_CFG.get("plots", {}).get("include_no_threshold", True)).lower(),
        dataset_name=lambda wc: DATASET_NAME
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.output_dir}"

        python "{params.script}" \
          --split-root "{params.split_root}" \
          --output-dir "{params.output_dir}" \
          --dataset-name "{params.dataset_name}" \
          --fig-format "{params.fig_format}" \
          --dpi {params.dpi} \
          --cmap "{params.cmap}" \
          --annotate "{params.annotate}" \
          --include-no-threshold "{params.include_no_threshold}"

        touch "{output.done}"
        """


def cleanup_inputs_for_rule(wildcards=None):
    inputs = list(SPLIT_TARGETS)
    if ANALYSIS_ENABLED:
        inputs.append(ANALYSIS_DONE_TARGET)
    return inputs


rule cleanup_materialized_inputs:
    input:
        cleanup_inputs_for_rule
    output:
        marker=cleanup_marker_path()
    run:
        root = Path(str(MATERIALIZED_ROOT)).resolve()
        parent = root.parent

        if root.exists():
            print(f"[INFO] Removing temporary materialized split inputs: {root}")
            shutil.rmtree(root)
        else:
            print(f"[INFO] Temporary materialized split input folder does not exist: {root}")

        # Remove split_process_inputs/ only if it is empty.
        # This avoids deleting temporary inputs from another dataset.
        if parent.name == "split_process_inputs":
            try:
                parent.rmdir()
                print(f"[INFO] Removed empty parent folder: {parent}")
            except FileNotFoundError:
                print(f"[INFO] Parent folder does not exist: {parent}")
            except OSError:
                print(f"[INFO] Parent folder was not removed because it is not empty: {parent}")
        else:
            print(
                f"[INFO] Parent folder was not removed because it does not look like "
                f"'split_process_inputs': {parent}"
            )

        Path(output.marker).parent.mkdir(parents=True, exist_ok=True)
        Path(output.marker).write_text("removed\n", encoding="utf-8")


# ============================================================
# Materialize split inputs
# ============================================================

rule materialize_no_threshold:
    input:
        source=lambda wc: SCENARIOS[(wc.scenario, "")]["source_file"],
        train_full=lambda wc: rep_full_data(SCENARIOS[(wc.scenario, "")]["train_rep"])
    output:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "full_data.csv"),
        metadata=str(MATERIALIZED_ROOT / "{scenario}" / "metadata.json")
    run:
        materialize_dataset(
            source_path=input.source,
            train_full_path=input.train_full,
            output_path=output.full_data,
            metadata_path=output.metadata,
            meta=SCENARIOS[(wildcards.scenario, "")]
        )


rule materialize_with_threshold:
    input:
        source=lambda wc: SCENARIOS[(wc.scenario, wc.threshold)]["source_file"],
        train_full=lambda wc: rep_full_data(SCENARIOS[(wc.scenario, wc.threshold)]["train_rep"])
    output:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "full_data.csv"),
        metadata=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "metadata.json")
    run:
        materialize_dataset(
            source_path=input.source,
            train_full_path=input.train_full,
            output_path=output.full_data,
            metadata_path=output.metadata,
            meta=SCENARIOS[(wildcards.scenario, wildcards.threshold)]
        )


def materialize_dataset(source_path, train_full_path, output_path, metadata_path, meta):
    source_path = Path(str(source_path))
    train_full_path = Path(str(train_full_path))
    output_path = Path(str(output_path))
    metadata_path = Path(str(metadata_path))

    if not source_path.exists():
        raise FileNotFoundError(f"Source dataset not found: {source_path}")
    if not train_full_path.exists():
        raise FileNotFoundError(f"Training representation full_data not found: {train_full_path}")

    output_path.parent.mkdir(parents=True, exist_ok=True)

    src = pd.read_csv(source_path)
    feat = pd.read_csv(train_full_path)

    if meta["source_kind"] == "no_reduced" and source_path.resolve() == train_full_path.resolve():
        out = feat.copy()
    else:
        join_col = None
        if ID_COL in src.columns and ID_COL in feat.columns:
            join_col = ID_COL
        elif SEQUENCE_COL in src.columns and SEQUENCE_COL in feat.columns:
            join_col = SEQUENCE_COL

        if join_col is None:
            raise ValueError(
                f"Could not merge source with representation. "
                f"Neither '{ID_COL}' nor '{SEQUENCE_COL}' is present in both files.\n"
                f"source columns: {src.columns.tolist()}\n"
                f"feature columns: {feat.columns.tolist()}"
            )

        src = src.copy()
        src["_order"] = range(len(src))

        keep_cols = [join_col, "_order"]
        for c in [ID_COL, SEQUENCE_COL, LABEL_COL]:
            if c in src.columns and c not in keep_cols:
                keep_cols.append(c)

        src_core = src[keep_cols].drop_duplicates(subset=[join_col], keep="first")
        out = src_core.merge(feat, on=join_col, how="inner", suffixes=("_source", ""))

        if out.empty:
            raise ValueError(
                f"Merge produced 0 rows using join_col='{join_col}'. "
                f"source={source_path}, train_full={train_full_path}"
            )

        # Prefer source metadata columns if available.
        for c in [ID_COL, SEQUENCE_COL, LABEL_COL]:
            source_c = f"{c}_source"
            if source_c in out.columns:
                if c in out.columns:
                    out[c] = out[source_c].combine_first(out[c])
                else:
                    out[c] = out[source_c]
                out = out.drop(columns=[source_c])

        out = out.sort_values("_order").drop(columns=["_order"])
        out = out.loc[:, ~out.columns.duplicated()]

    required = [ID_COL, LABEL_COL]
    missing = [c for c in required if c not in out.columns]
    if missing:
        raise ValueError(
            f"Materialized dataset is missing required columns: {missing}. "
            f"Columns: {out.columns.tolist()}"
        )

    out.to_csv(output_path, index=False)

    metadata = dict(meta)
    metadata.update({
        "source_path": str(source_path),
        "train_full_path": str(train_full_path),
        "output_path": str(output_path),
        "n_rows": int(out.shape[0]),
        "n_columns": int(out.shape[1]),
    })
    metadata_path.write_text(json.dumps(metadata, indent=2), encoding="utf-8")


# ============================================================
# Distance arrays
# ============================================================

rule build_distance_arrays_no_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "full_data.csv")
    output:
        emb=str(MATERIALIZED_ROOT / "{scenario}" / "_distance_arrays" / "embeddings.npy"),
        ids=str(MATERIALIZED_ROOT / "{scenario}" / "_distance_arrays" / "embedding_ids.csv")
    run:
        build_distance_arrays(input.full_data, output.emb, output.ids, SCENARIOS[(wildcards.scenario, "")]["train_rep"])


rule build_distance_arrays_with_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "full_data.csv")
    output:
        emb=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "_distance_arrays" / "embeddings.npy"),
        ids=str(MATERIALIZED_ROOT / "{scenario}" / "{threshold}" / "_distance_arrays" / "embedding_ids.csv")
    run:
        build_distance_arrays(input.full_data, output.emb, output.ids, SCENARIOS[(wildcards.scenario, wildcards.threshold)]["train_rep"])


def build_distance_arrays(full_data_path, emb_path, ids_path, train_rep):
    import numpy as np

    df = pd.read_csv(full_data_path)

    rep = rep_cfg(train_rep)
    feature_mode = rep_feature_mode(train_rep)

    if ID_COL not in df.columns:
        raise ValueError(f"ID column '{ID_COL}' not found in {full_data_path}")

    if feature_mode == "descriptors":
        prefix = rep_feature_prefix(train_rep)
        feature_cols = [c for c in df.columns if str(c).startswith(prefix)]
    else:
        non_feature_cols = {SEQUENCE_COL, ID_COL, LABEL_COL}
        feature_cols = [c for c in df.columns if c not in non_feature_cols and pd.api.types.is_numeric_dtype(df[c])]

    if not feature_cols:
        raise ValueError(
            f"No feature columns found for train_rep={train_rep} in {full_data_path}"
        )

    Path(emb_path).parent.mkdir(parents=True, exist_ok=True)
    df[feature_cols].to_numpy(dtype="float32")
    np.save(emb_path, df[feature_cols].to_numpy(dtype="float32"))
    df[[ID_COL]].to_csv(ids_path, index=False)


