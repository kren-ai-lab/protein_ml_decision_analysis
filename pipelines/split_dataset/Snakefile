rule write_basic_params_no_threshold:
    input:
        full_data=str(MATERIALIZED_ROOT / "{scenario}" / "full_data.csv")
    output:
        yaml_file=str(SPLIT_ROOT / "{scenario}" / "{strategy}" / "seed_{seed}" / "params_split.yaml")
    wildcard_constraints:
        strategy="random_kfold|stratified_kfold"
    run:
        write_params_yaml(
            output_yaml=output.yaml_file,
            strategy_dir=wildcards.strategy,
            seed=wildcards.seed,
            scenario=wildcards.scenario,
            threshold=""
        )


