configfile: "config/config.yaml"

from pathlib import Path
import pandas as pd


OUTPUT_ROOT = config["global"]["output_root"]

DATASET_NAME = config["dataset"]["name"]
INPUT_DATA = config["dataset"]["input_data"]
SEQUENCE_COL = config["dataset"]["sequence_col"]
ID_COL = config["dataset"]["id_col"]
LABEL_COL = config["dataset"]["label_col"]

REP_CFG = config["representation"]
ANALYSIS_CFG = config["analysis"]
REDUCTION_CFG = config["reduction"]
SPLIT_CFG = config["split"]


def represented_dir():
    return f"{OUTPUT_ROOT}/represented_dataset/{DATASET_NAME}"


def analysed_dir():
    return f"{OUTPUT_ROOT}/analysed_space/{DATASET_NAME}"


def reduced_dir():
    return f"{OUTPUT_ROOT}/reduced_dataset/{DATASET_NAME}"


def split_dir():
    return f"{OUTPUT_ROOT}/split_dataset/{SPLIT_CFG['strategy']}"


rule all:
    input:
        f"{represented_dir()}/full_data.csv",
        f"{analysed_dir()}/artifacts/training_embeddings.npy",
        f"{analysed_dir()}/tables/{ANALYSIS_CFG['prefix']}_similarity_percentiles.csv",
        f"{reduced_dir()}/reduction_summary.csv",
        f"{split_dir()}/DONE.txt"


rule represent_dataset:
    input:
        input_data=INPUT_DATA
    output:
        full_data=f"{OUTPUT_ROOT}/represented_dataset/{DATASET_NAME}/full_data.csv"
    params:
        rep_dir=represented_dir(),
        method=REP_CFG["method"],
        model=REP_CFG["model"],
        device=REP_CFG.get("device", "cuda"),
        precision=REP_CFG.get("precision", "fp16"),
        batch_size=REP_CFG.get("batch_size", 16),
        sequence_col=SEQUENCE_COL,
        emb_output=f"{OUTPUT_ROOT}/represented_dataset/{DATASET_NAME}/embeddings.parquet",
    run:
        Path(params.rep_dir).mkdir(parents=True, exist_ok=True)

        if not REP_CFG["enabled"]:
            raise ValueError("Representation is disabled in config.")

        if params.method != "sylphy_embedding":
            raise ValueError(f"Unsupported representation method: {params.method}")

        shell(
            r"""
            sylphy get-embedding \
              --model "{params.model}" \
              --input-data "{input.input_data}" \
              --sequence-identifier "{params.sequence_col}" \
              --output "{params.emb_output}" \
              --device {params.device} \
              --precision {params.precision} \
              --batch-size {params.batch_size}
            """
        )

        input_df = pd.read_csv(input.input_data)
        emb_df = pd.read_parquet(params.emb_output)

        if len(input_df) != len(emb_df):
            raise ValueError(
                f"Row mismatch between input data ({len(input_df)}) and embedding output ({len(emb_df)})."
            )

        duplicated_cols = [col for col in emb_df.columns if col in input_df.columns]
        if duplicated_cols:
            emb_df = emb_df.drop(columns=duplicated_cols)

        full_df = pd.concat(
            [input_df.reset_index(drop=True), emb_df.reset_index(drop=True)],
            axis=1
        )

        full_df = full_df.loc[:, ~full_df.columns.duplicated()]
        full_df.to_csv(output.full_data, index=False)


rule analyse_embedding_space:
    input:
        full_data=f"{OUTPUT_ROOT}/represented_dataset/{DATASET_NAME}/full_data.csv"
    output:
        npy=f"{OUTPUT_ROOT}/analysed_space/{DATASET_NAME}/artifacts/training_embeddings.npy",
        percentiles=f"{OUTPUT_ROOT}/analysed_space/{DATASET_NAME}/tables/{ANALYSIS_CFG['prefix']}_similarity_percentiles.csv",
        config_csv=f"{OUTPUT_ROOT}/analysed_space/{DATASET_NAME}/tables/{ANALYSIS_CFG['prefix']}_config.csv"
    params:
        out_dir=analysed_dir(),
        script=ANALYSIS_CFG["script"],
        label_col=LABEL_COL,
        sequence_col=SEQUENCE_COL,
        id_col=ID_COL,
        feature_prefix=ANALYSIS_CFG["feature_prefix"],
        scaling_strategy=ANALYSIS_CFG["scaling_strategy"],
        random_state=config["global"]["random_state"],
        tsne_perplexity=ANALYSIS_CFG["tsne_perplexity"],
        tsne_max_iter=ANALYSIS_CFG["tsne_max_iter"],
        umap_neighbors=ANALYSIS_CFG["umap_neighbors"],
        umap_min_dist=ANALYSIS_CFG["umap_min_dist"],
        umap_metric=ANALYSIS_CFG["umap_metric"],
        prefix=ANALYSIS_CFG["prefix"],
    run:
        Path(params.out_dir).mkdir(parents=True, exist_ok=True)

        if not ANALYSIS_CFG["enabled"]:
            raise ValueError("Analysis is disabled in config.")

        shell(
            r"""
            python "{params.script}" \
              --emb-train "{input.full_data}" \
              --output-dir "{params.out_dir}" \
              --label-col "{params.label_col}" \
              --sequence-col "{params.sequence_col}" \
              --id-col "{params.id_col}" \
              --feature-prefix "{params.feature_prefix}" \
              --prefix "{params.prefix}" \
              --random-state {params.random_state} \
              --tsne-perplexity {params.tsne_perplexity} \
              --tsne-max-iter {params.tsne_max_iter} \
              --umap-neighbors {params.umap_neighbors} \
              --umap-min-dist {params.umap_min_dist} \
              --umap-metric "{params.umap_metric}" \
              --scaling-strategy "{params.scaling_strategy}"
            """
        )


rule reduce_embeddings:
    input:
        full_data=f"{OUTPUT_ROOT}/represented_dataset/{DATASET_NAME}/full_data.csv",
        embedding_npy=f"{OUTPUT_ROOT}/analysed_space/{DATASET_NAME}/artifacts/training_embeddings.npy",
        percentiles=f"{OUTPUT_ROOT}/analysed_space/{DATASET_NAME}/tables/{ANALYSIS_CFG['prefix']}_similarity_percentiles.csv"
    output:
        summary=f"{OUTPUT_ROOT}/reduced_dataset/{DATASET_NAME}/reduction_summary.csv"
    params:
        out_dir=reduced_dir(),
        script=REDUCTION_CFG["script"],
        label_col=LABEL_COL,
        id_col=ID_COL,
    run:
        Path(params.out_dir).mkdir(parents=True, exist_ok=True)

        if not REDUCTION_CFG["enabled"]:
            raise ValueError("Reduction is disabled in config.")

        shell(
            r"""
            python "{params.script}" \
              --embedding-npy "{input.embedding_npy}" \
              --percentiles-csv "{input.percentiles}" \
              --input-data "{input.full_data}" \
              --output-dir "{params.out_dir}" \
              --label-col "{params.label_col}" \
              --id-col "{params.id_col}"
            """
        )


rule create_splits:
    input:
        reduction_summary=f"{OUTPUT_ROOT}/reduced_dataset/{DATASET_NAME}/reduction_summary.csv",
        full_data=f"{OUTPUT_ROOT}/represented_dataset/{DATASET_NAME}/full_data.csv"
    output:
        done=f"{OUTPUT_ROOT}/split_dataset/{SPLIT_CFG['strategy']}/DONE.txt"
    params:
        strategy=SPLIT_CFG["strategy"],
        split_params=SPLIT_CFG["params"],
        output_dir=split_dir(),
        script=SPLIT_CFG["script"]
    run:
        Path(params.output_dir).mkdir(parents=True, exist_ok=True)

        if not SPLIT_CFG["enabled"]:
            raise ValueError("Split is disabled in config.")

        if params.strategy != "distance_aware_kfold":
            raise ValueError(
                f"This pipeline expects strategy='distance_aware_kfold', got '{params.strategy}'."
            )

        shuffle_ties_flag = "--shuffle-ties" if params.split_params.get("shuffle_ties", False) else ""

        shell(
            rf"""
            python "{params.script}" \
              --reduction-summary "{input.reduction_summary}" \
              --reduction-dir "{reduced_dir()}" \
              --full-data "{input.full_data}" \
              --output-dir "{params.output_dir}" \
              --label-col "{LABEL_COL}" \
              --id-col "{ID_COL}" \
              --feature-prefix "{ANALYSIS_CFG['feature_prefix']}" \
              --n-splits {params.split_params['n_splits']} \
              --seed {params.split_params.get('seed', config['global']['seed'])} \
              --val-size {params.split_params['val_size']} \
              --metric "{params.split_params['metric']}" \
              {shuffle_ties_flag}
            """
        )

        with open(output.done, "w") as f:
            f.write("done\n")